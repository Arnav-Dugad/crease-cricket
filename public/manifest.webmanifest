{
  "name": "Crease — Live Cricket",
  "short_name": "Crease",
  "description": "Live cricket scores, ball-by-ball commentary, scorecards and analytics.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait-primary",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["sports", "news"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Live & today", "url": "/matches", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Rankings", "url": "/rankings", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Multi-match view", "url": "/multi", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
