{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crease-cricket",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/sitemap.xml", "/match/*", "/series/*", "/player/*", "/team/*", "/", "/matches", "/series", "/rankings", "/news"]
  },
  // Workers AI (free tier) writes match stories when no ANTHROPIC_API_KEY secret is set.
  "ai": { "binding": "AI" },
  // One LiveRoom per live match pushes real-time score ticks over WebSockets.
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "LiveRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveRoom"] }]
}
